{
  "expo": {
    "name": "Tatvan Ray",
    "slug": "tatvan-ray",
    "version": "0.1.0",
    "newArchEnabled": false,
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#F4F1E8"
    },
    "android": {
      "package": "com.tatvan.ray",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#17352E"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tatvan.ray"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Tren teşkil belgelerini cihaz üzerinde okumak için fotoğraflara erişim gerekir.",
          "cameraPermission": "Tren teşkil belgesinin fotoğrafını çekmek için kamera erişimi gerekir."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "7feb02f9-4bfb-47b8-aa41-632a3af5f3c7"
      }
    }
  }
}
